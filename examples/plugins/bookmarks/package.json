{
  "name": "patcher-plugin-bookmarks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "patcher": ">=0.0",
    "patcherPluginSdk": "^1.0.0"
  },
  "patcher": {
    "name": "Bookmarks",
    "description": "Save pages with the star, Cmd+D or the address bar, and find them again on a new tab.",
    "branding": {
      "icon": "Star"
    },
    "server": "./server.ts",
    "permissions": [
      "toolbar.register",
      "newTab.register",
      "omnibox.register",
      "tabs.read"
    ]
  },
  "keywords": [
    "patcher-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@patcher/plugin-sdk": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.1"
  }
}
