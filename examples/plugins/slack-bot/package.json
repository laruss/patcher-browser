{
  "name": "patcher-plugin-slack-bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "patcher": ">=0.0",
    "patcherPluginSdk": "^1.0.0"
  },
  "patcher": {
