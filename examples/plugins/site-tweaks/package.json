{
  "name": "patcher-plugin-site-tweaks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Declutter GitHub, and keep notes on a repository in the browser's own edge.",
  "engines": {
    "patcher": ">=0.0",
    "patcherPluginSdk": "^1.0.0"
  },
  "patcher": {
    "name": "Site tweaks",
    "description": "Declutter GitHub, and keep notes on a repository in the browser's own edge.",
    "branding": {
      "icon": "StickyNote"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "permissions": [
      "pageStyle.register",
      "pageScript.register"
    ],
    "sites": [
      "https://github.com/**"
    ]
  },
  "keywords": [
    "patcher-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@patcher/plugin-sdk": "workspace:*",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "better-sqlite3": "12.10.0",
    "react": "^19.0.0",
    "typescript": "^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.1"
  }
}
