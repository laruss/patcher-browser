{
  "name": "patcher-plugin-browser-tools",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Let agents read and drive the browser surface — tabs, pages and navigation.",
  "engines": {
    "patcher": ">=0.0"
  },
  "patcher": {
    "name": "Browser tools",
    "description": "Let agents read and drive the browser surface — tabs, pages and navigation.",
    "branding": {
      "icon": "Globe02"
    },
    "server": "./src/server.ts",
    "permissions": [
      "network.intercept",
      "network.observe",
      "page.credentials",
      "page.inject",
      "page.interact",
      "page.read",
      "page.record",
      "tabs.modify",
      "tabs.read"
    ]
  },
  "keywords": [
    "patcher-plugin"
  ],
  "scripts": {
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@patcher/plugin-sdk": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.1"
  }
}
