{
  "name": "patcher-plugin-github",
  "version": "0.2.1",
  "description": "Browse GitHub issues and pull requests in Patcher, then send them to agents.",
  "private": true,
  "license": "MIT",
  "homepage": "https://github.com/laruss/patcher-browser#readme",
  "bugs": {
    "url": "https://github.com/laruss/patcher-browser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laruss/patcher-browser.git",
    "directory": "plugins/github"
  },
  "type": "module",
  "files": [
    "dist",
    "server.ts",
    "app.tsx",
    "components",
    "README.md"
  ],
  "engines": {
    "patcher": ">=0.0",
    "patcherPluginSdk": "^1.0.0"
  },
  "patcher": {
    "name": "GitHub",
    "description": "Browse GitHub issues and pull requests in Patcher, then send them to agents.",
    "branding": {
      "icon": "Github"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "permissions": [
      "threads",
      "workspace"
    ]
  },
  "keywords": [
    "patcher-plugin"
  ],
  "scripts": {
    "build": "node --conditions=source --import tsx ../../scripts/build-official-plugins.mjs github",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "devDependencies": {
    "@patcher/plugin-sdk": "workspace:*",
    "@pierre/diffs": "^1.2.9",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "typescript": "^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vaul": "^1.1.2",
    "vitest": "^4.1.1"
  },
  "dependencies": {
    "@patcher/shared-ui": "workspace:*",
    "@radix-ui/react-slot": "^1.3.0",
    "zod": "^4.3.6"
  }
}
