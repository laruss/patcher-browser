{
  "name": "patcher-plugin-automations",
  "version": "0.1.0",
  "description": "Schedule recurring and one-shot agent or script work.",
  "private": true,
  "type": "module",
  "exports": {
    "./detail-view": "./detail-view.tsx",
    "./overview-view": "./overview-view.tsx",
    "./rpc-types": "./src/rpc-types.ts"
  },
  "engines": {
    "patcher": ">=0.0"
  },
  "patcher": {
    "name": "Automations",
    "description": "Schedule recurring and one-shot agent or script work.",
    "branding": {
      "icon": "Clock"
    },
    "server": "./src/server.ts",
    "app": "./app.tsx",
    "permissions": [
      "threads",
      "workspace"
    ],
    "skills": [
      "skills"
    ]
  },
  "keywords": [
    "patcher-plugin"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@patcher/shared-ui": "workspace:*",
    "@radix-ui/react-slot": "^1.3.0",
    "cron-parser": "^5.5.0",
    "cronstrue": "^3.14.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@patcher/plugin-sdk": "workspace:*",
    "@radix-ui/react-dialog": "^1.1.19",
    "@radix-ui/react-dropdown-menu": "^2.1.20",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "better-sqlite3": "12.10.0",
    "jsdom": "^29.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sonner": "^1.7.4",
    "typescript": "^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vaul": "^1.1.2",
    "vitest": "^4.1.1"
  }
}
