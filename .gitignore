# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
node_modules
/.pnp
.pnp.*
.idea
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# testing
/coverage

# next.js
.next
dist
out

# production
/build
/apps/app/build/
/packages/patcher-app/host-daemon/
/apps/desktop/release/
/apps/desktop/.electron-builder.generated.json

# generated at build time (see @patcher/sdk#generate:app-runtime-browser-bundle)
/packages/sdk/src/app-runtime-browser-bundle.generated.ts

# misc
.DS_Store
*.pem

# temporary scripts
.tmp/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.dev.vars

# cloudflare wrangler local state
.wrangler/
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/data/
output.txt

# codex, claude code
.claude/settings.local.json
.hermes/plans/
.otto/

# turborepo
.turbo

# Temp roots from the CLI packaged-plugin build test (mkdtemp under apps/cli)
apps/cli/.packaged-plugin-build-*

# Generated by the patcher:bundle-stats Vite plugin for the boot-payload budget check.
apps/app/bundle-stats.json
