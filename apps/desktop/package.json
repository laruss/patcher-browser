{
  "name": "@patcher/desktop",
  "version": "0.37.0",
  "private": true,
  "description": "macOS Electron shell for Patcher",
  "main": "dist/main.js",
  "os": [
    "darwin"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "rimraf dist release",
    "desktop:build": "bun run build && node scripts/run-electron-builder.mjs --mac --arm64 --publish always",
    "desktop:version-feed": "tsx scripts/generate-version-feed.mts",
    "dev": "bun run prepare-runtime && bun run build && node --conditions=source --import tsx scripts/run-electron-dev.mjs",
    "dist": "bun run prepare-runtime && bun run desktop:build",
    "package": "bun run prepare-runtime && bun run build && node scripts/run-electron-builder.mjs --mac --dir --arm64",
    "prepare-runtime": "turbo run build --filter=patcher-app --output-logs=new-only",
    "smoke:packaged": "node scripts/smoke-packaged-app.mjs",
    "start": "bun run package && node scripts/run-packaged-app.mjs",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "patcher-app": "workspace:*",
    "electron-updater": "^6.8.3",
    "semver": "^7.7.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@patcher/config": "workspace:*",
    "@patcher/desktop-contract": "workspace:*",
    "@patcher/domain": "workspace:*",
    "@patcher/server-contract": "workspace:*",
    "@patcher/tsconfig": "workspace:*",
    "@types/node": "^24.9.0",
    "@types/semver": "^7.7.0",
    "electron": "41.7.0",
    "electron-builder": "^26.8.1",
    "esbuild": "^0.28.0",
    "rimraf": "^6.1.0",
    "tsx": "^4.23.1",
    "typescript": "^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "unpdf": "^1.8.1",
    "vitest": "^4.1.1",
    "yaml": "^2.8.2"
  }
}
