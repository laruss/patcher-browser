{
  "appId": "app.patcher.desktop",
  "productName": "Patcher",
  "artifactName": "${productName}-${version}-${arch}.${ext}",
  "afterPack": "scripts/prepare-native-modules.cjs",
  "asar": true,
  "asarUnpack": ["dist/patcher-app-bridge.mjs", "node_modules/**"],
  "directories": {
    "buildResources": "assets",
    "output": "release"
  },
  "files": [
    "assets/**",
    "dist/**",
    "node_modules/**",
    {
      "from": "node_modules/patcher-app/server/dist/app-scaffold-template",
      "to": "node_modules/patcher-app/server/dist/app-scaffold-template",
      "filter": ["**/*"]
    },
    "package.json",
    "!**/*.map"
  ],
  "publish": [
    {
      "channel": "latest",
      "provider": "generic",
      "url": "https://github.com/laruss/patcher-browser/releases/download/desktop-latest/"
    }
  ],
  "mac": {
    "category": "public.app-category.developer-tools",
    "entitlements": "build/entitlements.mac.plist",
    "entitlementsInherit": "build/entitlements.mac.inherit.plist",
    "gatekeeperAssess": false,
    "hardenedRuntime": true,
    "extendInfo": {
      "CFBundleURLTypes": [
        {
          "CFBundleTypeRole": "Viewer",
          "CFBundleURLName": "Web site URL",
          "CFBundleURLSchemes": ["http", "https"]
        }
      ],
      "NSUserActivityTypes": ["NSUserActivityTypeBrowsingWeb"]
    },
    "icon": "assets/icon.icns",
    "identity": null,
    "notarize": false,
    "target": [
      {
        "target": "dmg",
        "arch": ["arm64"]
      },
      {
        "target": "zip",
        "arch": ["arm64"]
      }
    ]
  },
  "dmg": {
    "sign": false
  },
  "npmRebuild": false
}
