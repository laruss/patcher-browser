{
  "name": "@patcher/cli",
  "version": "0.0.1",
  "type": "module",
  "bin": {
    "patcher": "./bin/patcher",
    "title": "./bin/title"
  },
  "scripts": {
    "build": "node ../../packages/plugin-build/scripts/generate-runtime-export-manifest.mjs && node ../../scripts/build-node-entry.mjs src/index.ts dist/index.js --clean-dist --templates",
    "start": "node dist/index.js",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@patcher/config": "workspace:*",
    "@patcher/core-ui": "workspace:*",
    "@patcher/domain": "workspace:*",
    "@patcher/plugin-build": "workspace:*",
    "@patcher/sdk": "workspace:*",
    "@patcher/server-contract": "workspace:*",
    "@patcher/templates": "workspace:*",
    "@patcher/thread-view": "workspace:*",
    "cli-table3": "^0.6.5",
    "commander": "^13.0.0",
    "mime-types": "^3.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@patcher/tsconfig": "workspace:*",
    "@tailwindcss/node": "^4.3.0",
    "@tailwindcss/oxide": "^4.3.0",
    "@types/mime-types": "^3.0.1",
    "@types/node": "^22.0.0",
    "esbuild": "^0.28.0",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2"
  }
}
