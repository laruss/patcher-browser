{
  "name": "@patcher/scripts",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "bin": {
    "patcher-script-archive-codex-tmp-patcher-sessions": "./dist/commands/archive-codex-tmp-patcher-sessions.js",
    "patcher-script-request-dev-restart": "./dist/commands/request-dev-restart.js",
    "patcher-script-reset-patcher-data": "./dist/commands/reset-patcher-data.js",
    "patcher-script-run-cli": "./dist/commands/run-cli.js",
    "patcher-script-run-host-daemon": "./dist/commands/run-host-daemon.js",
    "patcher-script-seed-perf-db": "./dist/commands/seed-perf-db.js"
  },
  "exports": {
    "./lib/run-dev-supervisor": {
      "source": "./src/lib/run-dev-supervisor.ts",
      "types": "./src/lib/run-dev-supervisor.ts",
      "import": "./dist/lib/run-dev-supervisor.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ../../scripts/build-package.mjs",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "cli": "node dist/commands/run-cli.js",
    "dev:host-daemon": "node dist/commands/run-host-daemon.js --auto-join",
    "dev:restart": "node dist/commands/request-dev-restart.js both",
    "dev:restart-host-daemon": "node dist/commands/request-dev-restart.js host-daemon",
    "dev:restart-server": "node dist/commands/request-dev-restart.js server",
    "reset": "node dist/commands/reset-patcher-data.js",
    "codex:archive-tmp-patcher-sessions": "node dist/commands/archive-codex-tmp-patcher-sessions.js"
  },
  "dependencies": {
    "@patcher/config": "workspace:*",
    "@patcher/db": "workspace:*",
    "@patcher/domain": "workspace:*",
    "@patcher/host-daemon-contract": "workspace:*",
    "@patcher/process-utils": "workspace:*",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@patcher/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "typescript": "^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.1"
  }
}
