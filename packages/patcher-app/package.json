{
  "name": "patcher-app",
  "version": "0.37.0",
  "description": "Patcher app launcher for npx",
  "keywords": [
    "patcher",
    "coding-agent",
    "agent",
    "cli",
    "workspace",
    "codex",
    "claude-code"
  ],
  "homepage": "https://github.com/laruss/patcher-browser#readme",
  "bugs": {
    "url": "https://github.com/laruss/patcher-browser/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laruss/patcher-browser.git",
    "directory": "packages/patcher-app"
  },
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/public-sdk.ts",
      "types": "./dist/index.d.ts",
      "node": "./dist/index.js",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/patcher-app.js": "./dist/patcher-app.js"
  },
  "types": "./dist/index.d.ts",
  "os": [
    "darwin",
    "linux"
  ],
  "bin": {
    "patcher-app": "dist/patcher-app.js",
    "patcher": "dist/patcher.js",
    "patcher-server": "dist/patcher-server.js",
    "patcher-host-daemon": "dist/patcher-host-daemon.js"
  },
  "files": [
    "app/dist",
    "dist",
    "!dist/*.map",
    "host-daemon/dist/patcher",
    "host-daemon/dist/patcher-acp-bridge.mjs",
    "host-daemon/dist/patcher-claude-code-bridge.mjs",
    "host-daemon/dist/patcher-parcel-watcher-child.mjs",
    "host-daemon/dist/patcher-pi-bridge.mjs",
    "host-daemon/dist/daemon-bundle.mjs",
    "server/dist",
    "!server/dist/index.js.map",
    "README.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "clean": "rimraf dist app host-daemon server tsconfig.tsbuildinfo",
    "smoke:tarball": "node scripts/smoke-tarball.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --config vitest.config.ts"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "0.84.0",
    "@earendil-works/pi-ai": "0.84.0",
    "@earendil-works/pi-coding-agent": "0.84.0",
    "@earendil-works/pi-tui": "0.84.0",
    "@parcel/watcher": "2.5.6",
    "better-sqlite3": "12.10.0",
    "hono": "^4.7.0",
    "jiti": "^2.6.1",
    "node-pty": "1.1.0",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "pino-roll": "^4.0.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@patcher/config": "workspace:*",
    "@patcher/sdk": "workspace:*",
    "@patcher/tsconfig": "workspace:*",
    "@types/node": "^22.0.0",
    "rimraf": "^6.1.0",
    "rollup": "^4.62.2",
    "rollup-plugin-dts": "^6.4.1",
    "typescript": "^6.0.2",
    "typescript-7": "npm:typescript@^7.0.2",
    "vitest": "^4.1.1"
  },
  "engines": {
    "node": "^22.19.0 || ^24.0.0 || ^26.0.0"
  }
}
