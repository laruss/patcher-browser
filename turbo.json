{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    // Mirrors "build" but also caches bundle-stats.json, which the
    // patcher:bundle-stats Vite plugin writes beside dist for the boot-payload
    // budget check. Without it a cache hit would leave CI checking a stale
    // file, or none at all.
    "@patcher/app#build": {
      "dependsOn": ["topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/tsconfig/*.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/scripts/build-node-entry.mjs",
        "$TURBO_ROOT$/scripts/build-package.mjs",
        "$TURBO_ROOT$/scripts/build-utils.mjs",
        "$TURBO_ROOT$/scripts/precompress-app-dist.mjs",
        "$TURBO_ROOT$/turbo.json"
      ],
      "outputs": ["bundle-stats.json", "dist/**"]
    },
    "build": {
      "dependsOn": ["topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/tsconfig/*.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/scripts/build-node-entry.mjs",
        "$TURBO_ROOT$/scripts/build-package.mjs",
        "$TURBO_ROOT$/scripts/build-utils.mjs",
        "$TURBO_ROOT$/scripts/precompress-app-dist.mjs",
        "$TURBO_ROOT$/turbo.json"
      ],
      "outputs": ["dist/**"]
    },
    "@patcher/sdk#test": {
      "dependsOn": ["//#ensure-native-modules", "topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/apps/*/scripts/**",
        "$TURBO_ROOT$/apps/*/src/**",
        "$TURBO_ROOT$/apps/*/tsconfig.json",
        "$TURBO_ROOT$/apps/*/vite.config.ts",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/scripts/**",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/*/tsconfig.json",
        "$TURBO_ROOT$/packages/db/drizzle/**",
        "$TURBO_ROOT$/packages/tsconfig/*.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/scripts/*.mjs",
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/vitest.shared.ts"
      ]
    },
    "patcher-app#build": {
      // copy-builtin-plugins bundles every plugin in BUNDLED_PLUGINS; the
      // tasks plugin's app bundle imports the @patcher/plugin-sdk root at runtime
      // (shared RPC contract), so the SDK dist must exist first.
      "dependsOn": [
        "@patcher/app#build",
        "@patcher/server#build",
        "@patcher/host-daemon#build",
        "@patcher/cli#build",
        "@patcher/sdk#build",
        "@patcher/plugin-sdk#build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/app/dist/**",
        "$TURBO_ROOT$/apps/server/dist/**",
        "$TURBO_ROOT$/apps/host-daemon/dist/**",
        "$TURBO_ROOT$/packages/patcher-app/package.json",
        "$TURBO_ROOT$/packages/patcher-app/scripts/**",
        "$TURBO_ROOT$/packages/patcher-app/src/**",
        "$TURBO_ROOT$/packages/patcher-app/tsconfig.json",
        "$TURBO_ROOT$/packages/sdk/package.json",
        "$TURBO_ROOT$/packages/sdk/src/**",
        "$TURBO_ROOT$/packages/sdk/tsconfig.json",
        "$TURBO_ROOT$/packages/shared-ui/package.json",
        "$TURBO_ROOT$/packages/shared-ui/src/**",
        "$TURBO_ROOT$/packages/shared-ui/tsconfig.json",
        "$TURBO_ROOT$/packages/tsconfig/*.json",
        "$TURBO_ROOT$/plugins/*/**",
        "!$TURBO_ROOT$/plugins/*/dist/**",
        "!$TURBO_ROOT$/plugins/*/node_modules/**",
        "$TURBO_ROOT$/scripts/*.mjs"
      ],
      "outputs": ["app/**", "dist/**", "host-daemon/**", "server/**"]
    },
    "patcher-plugin-tasks#build": {
      // The tasks plugin's app bundle imports the @patcher/plugin-sdk root at
      // runtime (shared RPC contract), so the SDK dist must exist first.
      "dependsOn": ["topo", "@patcher/plugin-sdk#build"]
    },
    "@patcher/desktop#build": {
      "dependsOn": ["patcher-app#build"],
      "env": ["PATCHER_DESKTOP_RELEASE_CHANNEL"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/desktop/**",
        "$TURBO_ROOT$/packages/patcher-app/app/**",
        "$TURBO_ROOT$/packages/patcher-app/dist/**",
        "$TURBO_ROOT$/packages/patcher-app/host-daemon/**",
        "$TURBO_ROOT$/packages/patcher-app/package.json",
        "$TURBO_ROOT$/packages/patcher-app/server/**",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/turbo.json"
      ],
      "outputs": ["dist/**"]
    },
    "@patcher/desktop#desktop:build": {
      "dependsOn": ["patcher-app#build", "@patcher/desktop#build"],
      "cache": false,
      "outputs": ["release/**"],
      "passThroughEnv": ["*"]
    },
    "@patcher/desktop#smoke:app-boot": {
      "dependsOn": ["@patcher/app#build"],
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["*"]
    },
    "@patcher/desktop#smoke:packaged": {
      "cache": false,
      "outputs": [],
      "passThroughEnv": ["*"]
    },
    "@patcher/desktop#dev": {
      "dependsOn": ["patcher-app#build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "@patcher/desktop#start": {
      "dependsOn": ["patcher-app#build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "bundle": {
      "cache": false,
      "outputs": []
    },
    "template:build": {
      "cache": false,
      "outputs": []
    },
    "@patcher/app#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "storybook": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "@patcher/host-daemon#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "@patcher/server#dev": {
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "@patcher/host-daemon#start:prod": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "@patcher/server#start:prod": {
      "dependsOn": ["build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": ["*"]
    },
    "clean": {
      "cache": false
    },
    "lint": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/eslint.config.mjs",
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/bun.lock"
      ]
    },
    "//#ensure-native-modules": {
      "cache": false,
      "inputs": [
        "$TURBO_ROOT$/package.json",
        "$TURBO_ROOT$/packages/db/package.json",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/scripts/ensure-native-modules.mjs"
      ],
      "outputs": []
    },
    // Transit node (no package defines a `topo` script; nothing executes).
    // It exists so tasks that resolve `@patcher/*` imports to *sources* — vitest
    // and tsc both use the `source` export condition — hash the sources of
    // dependency packages. Without it, a change in e.g. packages/domain
    // would cache-hit @patcher/server#test/#typecheck and skip them stale.
    "topo": {
      "dependsOn": ["^topo"]
    },
    "typecheck": {
      "dependsOn": ["topo"]
    },
    "@patcher/templates#typecheck": {
      // Templates embed the plugin SDK's generated declarations by file path.
      // Keep the check from racing the SDK build without adding a package edge,
      // which would create a dependency cycle through @patcher/sdk.
      "dependsOn": ["@patcher/plugin-sdk#build", "topo"]
    },
    "@patcher/integration-tests#typecheck": {
      "dependsOn": ["topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/server/package.json",
        "$TURBO_ROOT$/apps/server/tsconfig.json",
        "$TURBO_ROOT$/apps/server/src/**",
        "$TURBO_ROOT$/packages/templates/package.json",
        "$TURBO_ROOT$/packages/templates/scripts/**",
        "$TURBO_ROOT$/packages/templates/src/**",
        "$TURBO_ROOT$/vitest.shared.ts"
      ]
    },
    "test": {
      "dependsOn": ["//#ensure-native-modules", "topo"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.shared.ts"]
    },
    // Same task as `test`, plus one hash input that is not a file: the Codex CLI
    // version CI installs. `permission-profile.sandbox.test.ts` measures what
    // that binary's sandbox refuses, and the binary is not an input turbo can
    // see — so without this, bumping the pin in ci.yml leaves the hash
    // unchanged and the "deliberate re-measurement" is served from cache.
    // Unset locally, which keeps the hash stable there.
    "@patcher/agent-runtime#test": {
      "dependsOn": ["//#ensure-native-modules", "topo"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.shared.ts"],
      "env": ["PATCHER_CODEX_CLI_VERSION"]
    },
    // The scripts suite is the only one that asserts things about the repository
    // rather than about its own package: that CHANGELOG.md carries an entry for
    // the version the two lockstep packages are on, and that the sentences in
    // README.md and docs/installation.md naming the download are still the ones
    // bump-version.mjs rewrites. None of those files is a package-local default,
    // and neither are the four root scripts the suite imports.
    //
    // Measured, not assumed. Without this block the task hash is byte-identical
    // before and after editing scripts/bump-version.mjs, README.md or
    // CHANGELOG.md, and moves only for the test file itself -- so a release
    // commit is exactly the shape that would have been served from cache: two
    // versions, a changelog entry and two documents, with nothing under
    // packages/scripts touched at all. With it, all seven files probed move the
    // hash: the two root scripts the suite imports, the three documents, and the
    // two manifests.
    "@patcher/scripts#test": {
      "dependsOn": ["//#ensure-native-modules", "topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/scripts/*.mjs",
        "$TURBO_ROOT$/CHANGELOG.md",
        "$TURBO_ROOT$/README.md",
        "$TURBO_ROOT$/docs/installation.md",
        "$TURBO_ROOT$/packages/patcher-app/package.json",
        "$TURBO_ROOT$/apps/desktop/package.json"
      ]
    },
    "@patcher/templates#test": {
      "dependsOn": [
        "//#ensure-native-modules",
        "@patcher/plugin-sdk#build",
        "topo"
      ],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.shared.ts"]
    },
    // The plugin suites build a real plugin, and a plugin's frontend build
    // resolves `@patcher/plugin-sdk` from that package's `dist/`. Without this
    // the tests pass on any machine that has ever run a build and fail on a
    // clean checkout or a CI shard that only runs tests: every plugin load
    // lands on `status: "error"` and the assertions read as unexplained.
    "@patcher/server#test": {
      "dependsOn": [
        "//#ensure-native-modules",
        "@patcher/plugin-sdk#build",
        "topo"
      ],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.shared.ts"]
    },
    "smoke:tarball": {
      "dependsOn": ["build"],
      "cache": false,
      "outputs": []
    },
    "@patcher/integration-tests#test": {
      "dependsOn": ["//#ensure-native-modules", "topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/server/package.json",
        "$TURBO_ROOT$/apps/server/tsconfig.json",
        "$TURBO_ROOT$/apps/server/src/**",
        "$TURBO_ROOT$/packages/templates/package.json",
        "$TURBO_ROOT$/packages/templates/scripts/**",
        "$TURBO_ROOT$/packages/templates/src/**",
        "$TURBO_ROOT$/vitest.shared.ts"
      ]
    },
    "test:smoke": {
      "dependsOn": ["//#ensure-native-modules", "topo"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.shared.ts"]
    },
    "@patcher/integration-tests#test:smoke": {
      "dependsOn": ["//#ensure-native-modules", "topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/server/package.json",
        "$TURBO_ROOT$/apps/server/tsconfig.json",
        "$TURBO_ROOT$/apps/server/src/**",
        "$TURBO_ROOT$/packages/templates/package.json",
        "$TURBO_ROOT$/packages/templates/scripts/**",
        "$TURBO_ROOT$/packages/templates/src/**",
        "$TURBO_ROOT$/vitest.shared.ts"
      ]
    },
    "test:integration": {
      "dependsOn": ["//#ensure-native-modules", "topo"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.shared.ts"]
    },
    "@patcher/integration-tests#test:integration": {
      "dependsOn": [
        "//#ensure-native-modules",
        "@patcher/agent-runtime#test:integration",
        "topo"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/server/package.json",
        "$TURBO_ROOT$/apps/server/tsconfig.json",
        "$TURBO_ROOT$/apps/server/src/**",
        "$TURBO_ROOT$/packages/templates/package.json",
        "$TURBO_ROOT$/packages/templates/scripts/**",
        "$TURBO_ROOT$/packages/templates/src/**",
        "$TURBO_ROOT$/vitest.shared.ts"
      ]
    },
    "@patcher/plugin-sdk#build": {
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/*/src/**",
        "$TURBO_ROOT$/packages/plugin-sdk/scripts/**"
      ],
      "outputs": ["bundled-types/**", "dist/**"]
    },
    "@patcher/plugin-build#typecheck": {
      "dependsOn": ["topo"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/apps/app/src/components/ui/theme.css",
        "$TURBO_ROOT$/bun.lock",
        "$TURBO_ROOT$/package.json"
      ]
    },
    "@patcher/plugin-registry#typecheck": {
      "dependsOn": ["topo"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/shared-ui/src/**"]
    },
    "@patcher/plugin-registry#test": {
      "dependsOn": ["//#ensure-native-modules", "topo"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/packages/shared-ui/src/**"]
    }
  }
}
